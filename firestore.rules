rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberOf(coupleId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      allow create: if signedIn() && request.resource.data.members.size() == 1 && request.auth.uid in request.resource.data.members;
      allow get: if signedIn() && (request.auth.uid in resource.data.members || resource.data.members.size() == 1);
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (resource.data.members.size() == 1 &&
         request.resource.data.members.size() == 2 &&
         resource.data.members[0] in request.resource.data.members &&
         request.auth.uid in request.resource.data.members &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );

      match /messages/{messageId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId) && request.resource.data.authorId == request.auth.uid;
      }
    }
  }
}
